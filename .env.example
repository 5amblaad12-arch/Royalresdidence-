# ---------- Required ----------
DATABASE_URL="file:./dev.db"                    # Production: libsql://your-db.turso.io
DATABASE_AUTH_TOKEN=""                          # Production only (Turso token)
AUTH_SECRET="change-me-to-a-long-random-string-32+"  # Signs admin logins. Keep secret.
ADMIN_EMAIL="owner@example.com"                 # Owner login. Created / updated on start.
ADMIN_PASSWORD="use-12-or-more-characters"      # 10 characters minimum
NEXT_PUBLIC_SITE_URL="https://theroyalnileresidence.com"  # Live address, no trailing slash

# ---------- Optional ----------
RESEND_API_KEY=""                               # Email alerts for new bookings
EMAIL_FROM="The Royal Nile Residence <bookings@your-domain.com>"
ALERT_EMAIL=""                                  # Where new-booking alerts go (defaults to ADMIN_EMAIL)

# ---------- Link with Egypt Knight Tours (optional) ----------
LINK_SECRET=""                                  # Long random text (48+ characters). Must be EXACTLY the same on both sites.
EGYPT_KNIGHT_URL="https://egyptknight.com"      # Egypt Knight's site address, no trailing slash
